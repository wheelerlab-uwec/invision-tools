{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": { "disabled": true },
    "ty": {
      "command": ["uvx", "ty", "server"],
      "extensions": [".py"]
    },
    "postgres-language-server": {
      "disabled": false,
      "command": ["postgres-language-server", "--stdio"],
      "extensions": [".sql", ".pgsql"],
      "env": {
        // No DB credentials: lint-only mode (syntax + lints)
      },
      "initialization": {
        "configFile": "postgres-language-server.jsonc",
        "telemetry": false,
        "diagnostics": {
          "enableSyntax": true,
          "enableLints": true,
          "enableTypeChecks": false
        }
      }
    }
  }
}

